# Copy this file to .env.local and use the same Firebase project for local development.
# VITE_ values are public web-app configuration. Never prefix server credentials with VITE_.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_PUBLIC_CONTACT_EMAIL=
VITE_PUBLIC_CONTACT_PHONE=

# Server-only Admin SDK credential. Set this in Vercel Environment Variables for API routes.
# Keep the JSON private and never commit a real value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional secret override for contact-form rate-limit key hashing.
# If omitted, the server derives the key from the service-account private key.
CONTACT_RATE_LIMIT_SECRET=

# Optional local credential file path for Admin SDK tools; keep the file outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=
